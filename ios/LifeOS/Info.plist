<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Life OS</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.hermes.lifeos.navigation</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lifeos</string>
            </array>
        </dict>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>APP_GROUP_IDENTIFIER</key>
    <string>$(APP_GROUP_IDENTIFIER)</string>
    <key>PROVISIONING_MODE</key>
    <string>$(PROVISIONING_MODE)</string>
    <key>LIFEOS_SYNC_APPROVED_HOSTS</key>
    <string>$(LIFEOS_SYNC_APPROVED_HOSTS)</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Life OS uses your local network to keep calendar items in sync with your Mac.</string>
    <key>NSCameraUsageDescription</key>
    <string>Life OS uses the camera only to scan a food barcode; no camera frames are stored or uploaded.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Life OS reads only the Health categories you select to show source-backed fitness, sleep, activity, hydration, and caffeine data.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_lifeos-calendar._tcp</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIAppFonts</key>
    <array>
        <string>Manrope-VariableFont_wght.ttf</string>
        <string>SpaceGrotesk-VariableFont_wght.ttf</string>
        <string>Inter-VariableFont.ttf</string>
    </array>
</dict>
</plist>
